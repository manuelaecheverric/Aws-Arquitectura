# Copiar como docker/.env.aws en la EC2 y completar. NO subir .env.aws al repositorio.
AIRFLOW_UID=1000
AIRFLOW_FERNET_KEY=<python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())">
AIRFLOW_SECRET_KEY=<cadena-aleatoria>
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=<clave-fuerte>
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<clave-fuerte>

AWS_REGION=us-east-2
S3_BUCKET=dw-user3-ecommerce-20261027
REDSHIFT_WORKGROUP=dw-user3-workgroup
REDSHIFT_DATABASE=dev
REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:redshift!dw-user3-namespace-dwadmin-XXXXXX
MYSQL_HOST=<endpoint-rds>
MYSQL_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:rds!db-XXXXXXXX
DOCDB_HOST=<endpoint-docdb>
DOCDB_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:dw-user3/docdb/master-XXXXXX
