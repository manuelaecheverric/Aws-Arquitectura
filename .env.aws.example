# Variables para la versión AWS. Copie este archivo como .env.aws y complete los valores.
# NUNCA suba .env.aws al repositorio (está en .gitignore). No contiene contraseñas de Redshift:
# se usa el ARN del secreto y los permisos IAM de la máquina que ejecuta (rol de la EC2).
AWS_REGION=us-east-2
S3_BUCKET=dw-user3-ecommerce-20261027

# Redshift Serverless (Data API)
REDSHIFT_WORKGROUP=dw-user3-workgroup
REDSHIFT_DATABASE=dev
REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-east-2:<cuenta>:secret:redshift!dw-user3-namespace-dwadmin-XXXXXX

# RDS for MySQL (fuente relacional)
MYSQL_HOST=<endpoint-de-rds>.us-east-2.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=<usuario>
MYSQL_PASSWORD=<se-lee-de-secrets-manager-en-ec2>

# DocumentDB (fuente documental). DocumentDB exige TLS y no admite retryWrites.
MONGODB_URI=mongodb://<usuario>:<clave>@<endpoint-docdb>:27017/?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DATABASE=ecommerce
