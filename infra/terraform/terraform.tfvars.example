# Copiar como terraform.tfvars (no se sube al repositorio si contiene datos de la cuenta)
bucket_name         = "dw-user3-ecommerce-20261027"
redshift_secret_arn = "arn:aws:secretsmanager:us-east-2:<cuenta>:secret:redshift!dw-user3-namespace-dwadmin-XXXXXX"
ssh_allowed_cidr    = "x.x.x.x/32"   # IP de CloudShell: curl -s https://checkip.amazonaws.com
